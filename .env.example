# ==============================================
# CRM YTS — Environment Configuration
# ==============================================

# Client-Safe Variables (Prefixed with VITE_)
# JANGAN PERNAH menaruh database credential atau auth secret di sini!
VITE_APP_NAME="CRM YTS"
VITE_API_BASE_URL="/api"

# Server-Only Variables (Netlify Functions Runtime)
# Wajib dirahasiakan dan TIDAK BOLEH berawalan VITE_
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_DIRECT="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
AUTH_SECRET="your-super-secret-auth-key-min-32-chars-length"
APP_URL="http://localhost:5173"
NODE_ENV="development"
