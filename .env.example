# Database
DATABASE_URL=
DATABASE_URL_DIRECT=

# Auth Secret
AUTH_SECRET=tarbiyah-sunnah-crm-jwt-secret-key-production-2026-auth
APP_URL=http://localhost:5173
NODE_ENV=development

# Mailketing transactional email (server-side only; jangan pernah gunakan VITE_)
MAILKETING_API_ENDPOINT=https://api.mailketing.co.id/api/v2/send
MAILKETING_API_TOKEN=
MAILKETING_FROM_NAME=Yayasan Tarbiyah Sunnah
MAILKETING_FROM_EMAIL=no-reply@yts.web.id
# Batas gabungan semua broadcast email per hari WIB (1-400).
MAILKETING_BROADCAST_DAILY_LIMIT=400
# Gunakan nilai acak minimal 16 karakter. Dipakai pada URL webhook, jangan dibagikan.
MAILKETING_WEBHOOK_SECRET=
