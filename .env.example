# Database
DATABASE_URL=
DATABASE_URL_DIRECT=

# Auth Secret
# Set a unique, random server secret of at least 32 characters before production.
AUTH_SECRET=
APP_URL=http://localhost:5173
NODE_ENV=development

# Mailketing transactional email (server-side only; jangan pernah gunakan VITE_)
MAILKETING_API_ENDPOINT=https://api.mailketing.co.id/api/v2/send
MAILKETING_API_TOKEN=
MAILKETING_FROM_NAME=Yayasan Tarbiyah Sunnah
MAILKETING_FROM_EMAIL=no-reply@yts.web.id
# Batas gabungan semua broadcast email per hari WIB (1-400).
MAILKETING_BROADCAST_DAILY_LIMIT=400
# Gunakan nilai acak minimal 16 karakter. Dipakai pada URL webhook, jangan dibagikan.
MAILKETING_WEBHOOK_SECRET=

# Google OAuth Client ID (absensi mandiri kajian rutin di /peserta/kajian).
# Dapatkan dari Google Cloud Console > APIs & Services > Credentials (tipe: Web application).
# Isi VITE_GOOGLE_CLIENT_ID dengan nilai yang sama agar tombol login Google tampil di browser.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Initial credential provisioning (server only; do not commit actual values).
# Run auth:bootstrap after applying drizzle/0012_staff_credentials.sql on staging.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
